# Copy this example to your own .local/pi05-libero.env and replace every PATH/TO
# placeholder with your resource path before using it. Quote paths with spaces.
# The launcher never loads this file automatically. From the repository root:
#   source .local/pi05-libero.env
# run.py command-line path arguments take precedence over these environment values.

# One Python executable path, without command-line flags.
export ROBOTICS_PI05_PYTHON="PATH/TO/PYTHON_ENV/bin/python"
export ROBOTICS_SIM_SOURCE="PATH/TO/compatible-vlash-sim-checkout"
export ROBOTICS_CHECKPOINT="PATH/TO/native-lerobot-pi05-libero-checkpoint"
export ROBOTICS_TOKENIZER="PATH/TO/matching-tokenizer"
export ROBOTICS_LIBERO_CONFIG_DIR="PATH/TO/libero-config"

# Optional: set these only when using a quantization configuration.
# export ROBOTICS_QUANT_SOURCE="PATH/TO/vlash-quantization-checkout"
# export ROBOTICS_KERNEL_SOURCE="PATH/TO/mini-qserve-gemm-checkout"

# Select the GPU explicitly with run.sh --gpu ... for actual execution.
# No model, tokenizer, kernel, or environment is installed by this file.
