# Existing local model resources and two compatible Python environments.
# Source this file explicitly; no resources are downloaded by the launcher.
export ROBOTICS_LINGBOT_SOURCE="PATH/TO/lingbot-va"
export ROBOTICS_LINGBOT_CHECKPOINT="PATH/TO/lingbot-va-posttrain-robotwin"
export ROBOTICS_LINGBOT_PYTHON="PATH/TO/model-env/bin/python"
export ROBOTICS_ROBOTWIN_SOURCE="PATH/TO/RoboTwin"
export ROBOTICS_ROBOTWIN_PYTHON="PATH/TO/simulator-env/bin/python"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTHONDONTWRITEBYTECODE=1
