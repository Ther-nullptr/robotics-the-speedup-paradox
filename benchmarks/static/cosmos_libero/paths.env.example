# Copy to .local/cosmos-libero.env, replace paths, then explicitly source it.
export ROBOTICS_COSMOS_PYTHON="PATH/TO/python"
export ROBOTICS_COSMOS_SOURCE="PATH/TO/cosmos-policy"
export ROBOTICS_COSMOS_CHECKPOINT="PATH/TO/Cosmos-Policy-LIBERO-Predict2-2B.pt"
export ROBOTICS_COSMOS_DATASET_STATS="PATH/TO/libero_dataset_statistics.json"
export ROBOTICS_COSMOS_TEXT_EMBEDDINGS="PATH/TO/libero_t5_embeddings.pkl"
export ROBOTICS_COSMOS_VAE_CHECKPOINT="PATH/TO/tokenizer.pth"
export ROBOTICS_COSMOS_LIBERO_CONFIG_DIR="PATH/TO/libero-config"
