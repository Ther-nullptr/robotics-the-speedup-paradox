# Source this file after replacing each local path. No source repository is required.
export ROBOTICS_DYNAMICVLA_PYTHON=/path/to/model-venv/bin/python
export ROBOTICS_DOM_PYTHON=/path/to/isaac-sim/python.sh
export ROBOTICS_DYNAMICVLA_CHECKPOINT=/path/to/dynamic-vla-DOM
export ROBOTICS_DOM_SCENES=/path/to/DOM/scenes
export ROBOTICS_DOM_OBJECTS=/path/to/DOM/objects
export ROBOTICS_DOM_ENV_CFG=/path/to/DOM/tests/one-franka-scene.json
export ROBOTICS_DYNAMICVLA_FRANKA_USD=/path/to/FrankaEmika/panda_instanceable.usd
# HF_HOME may point to an existing local tokenizer/backbone-config cache.
# Worker processes enforce offline Hugging Face loading.
